---
import { SITE } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = 'Usqay — Sistema de Negocios todo-en-uno para gestionar ventas, inventario, clientes y finanzas desde un solo lugar.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white text-usqay-text antialiased" style="font-family: 'DM Sans', sans-serif;">
    <slot />
  </body>
</html>
