---
import { STATS } from '@/data/site';
---

<section class="bg-usqay-navy py-12 sm:py-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <h2
      class="text-2xl sm:text-4xl lg:text-5xl font-black text-white text-center mb-8 sm:mb-16 leading-tight max-w-2xl mx-auto"
    >
      Cientos de negocios en Piura ya confían en Usqay
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-8">
      {
        STATS.map((stat) => (
          <div class="flex items-center gap-4 sm:block text-left border-l-4 border-usqay-orange pl-4 sm:pl-6">
            <p class="text-4xl sm:text-7xl lg:text-8xl font-black text-sky-400 leading-none mb-0 sm:mb-4 shrink-0 w-20 sm:w-auto text-center sm:text-left"
              style="font-family: Arial, sans-serif;">
              {stat.value}
            </p>
            <p class="text-xs sm:text-base text-blue-200 leading-relaxed" set:html={stat.description} />
          </div>
        ))
      }
    </div>
  </div>
</section>
