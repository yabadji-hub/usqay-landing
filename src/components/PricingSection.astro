---
import type { Plan } from '@/data/site';
import { PLANS } from '@/data/site';
const plansJSON = JSON.stringify(PLANS);
---

<!-- Planes por defecto embebidos como JSON para override del admin -->
<script id="default-pricing" type="application/json" is:inline set:html={plansJSON}></script>

<section id="planes" class="bg-usqay-cream px-4 sm:px-6 py-12 sm:py-20">
  <div class="max-w-6xl mx-auto">
    <div id="pricing-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      {
        PLANS.map((plan: Plan, i: number) => (
          <div
            class={[
              'pricing-card relative rounded-2xl flex flex-col',
              'transition-all duration-300 ease-out',
              plan.featured
                ? 'shadow-2xl shadow-orange-200 sm:scale-[1.03] sm:hover:scale-[1.05]'
                : 'bg-white border border-usqay-border shadow-sm hover:shadow-xl hover:-translate-y-1',
            ].join(' ')}
            style={`--delay: ${i * 100}ms`}
          >
            {plan.featured && plan.featuredLabel && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-white text-usqay-orange text-xs font-black px-4 py-1 rounded-full whitespace-nowrap shadow-lg border border-orange-100">
                {plan.featuredLabel}
              </div>
            )}

            <div class={['px-4 pt-6 pb-4 sm:px-6 sm:pt-8 sm:pb-6 rounded-t-2xl', plan.featured ? 'bg-gradient-to-br from-usqay-orange to-usqay-orange-dark text-white' : 'bg-white'].join(' ')}>
              <h3 class={['text-base sm:text-xl font-black mb-1', plan.featured ? 'text-white' : 'text-usqay-navy'].join(' ')} style="font-family: 'Playfair Display', serif;">
                {plan.name}
              </h3>
              <p class={['text-xs leading-relaxed mb-3 sm:mb-5 line-clamp-4 sm:line-clamp-none min-h-[4.9rem] sm:min-h-0', plan.featured ? 'text-orange-100' : 'text-usqay-muted'].join(' ')}>
                {plan.description}
              </p>
              <div class="mb-1">
                <div class="flex items-baseline gap-0.5">
                  <span class={['plan-original text-sm line-through mr-1', plan.featured ? 'text-orange-200' : 'text-usqay-subtle'].join(' ')}
                    data-monthly={plan.priceMonthly} data-annual={plan.priceAnnual} style="display:none">
                    S/{plan.priceMonthly}
                  </span>
                  <span class={['text-base font-semibold', plan.featured ? 'text-white' : 'text-usqay-navy'].join(' ')}>S/</span>
                  <span class={['plan-price text-3xl sm:text-5xl font-black leading-none', plan.featured ? 'text-white' : 'text-usqay-navy'].join(' ')}
                    data-monthly={plan.priceMonthly} data-annual={plan.priceAnnual}>
                    {plan.priceMonthly}
                  </span>
                  <span class={['text-sm ml-1', plan.featured ? 'text-orange-100' : 'text-usqay-muted'].join(' ')}>/mes</span>
                </div>
                {plan.annualSavingsLabel && (
                  <div class="plan-savings mt-2.5" style="display:none">
                    <span class={[
                      'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-black tracking-wide',
                      plan.featured
                        ? 'bg-white/20 text-white border border-white/30'
                        : 'bg-green-100 text-green-700 border border-green-200',
                    ].join(' ')}>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                      </svg>
                      {plan.annualSavingsLabel}
                    </span>
                  </div>
                )}
              </div>
            </div>

            <div class={['px-4 py-3 sm:px-6 sm:py-4', plan.featured ? 'bg-usqay-orange-dark' : 'bg-white'].join(' ')}>
              <a href={plan.ctaHref}
                class={['block w-full text-center py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 active:scale-95',
                  plan.featured
                    ? 'bg-white text-usqay-orange hover:bg-orange-50 shadow-md'
                    : 'bg-usqay-orange text-white hover:bg-usqay-orange-dark shadow-sm hover:shadow-orange-200 hover:shadow-md',
                ].join(' ')}>
                {plan.ctaLabel}
              </a>
            </div>

            <div class="bg-white flex-1 px-4 pt-4 pb-5 sm:px-6 sm:pt-5 sm:pb-6 rounded-b-2xl">
              <p class="text-[10px] uppercase tracking-widest text-usqay-subtle font-bold mb-3 sm:mb-4">Incluye</p>
              <ul class="space-y-1.5 sm:space-y-2.5">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2 sm:gap-2.5 text-xs sm:text-sm leading-snug">
                    <span class={['flex-shrink-0 mt-0.5 text-sm sm:text-base leading-none', f.included ? 'text-usqay-green' : 'text-usqay-subtle'].join(' ')}>
                      {f.included ? '✓' : '✗'}
                    </span>
                    <span class={f.included ? 'text-usqay-text font-medium' : 'text-usqay-subtle line-through'}>
                      {f.label}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pricing-card {
    opacity: 0;
    transform: translateY(28px);
  }
  .pricing-card.is-visible {
    animation: card-in 0.55s cubic-bezier(.22,.68,0,1.2) var(--delay, 0ms) both;
  }
  @keyframes card-in {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // ── Tipos ────────────────────────────────────────────────
  interface PlanFeature { label: string; included: boolean; }
  interface PlanOverride {
    id: string; name: string; emoji: string; featured: boolean; featuredLabel: string;
    description: string; priceMonthly: number; priceAnnual: number;
    annualSavingsLabel: string; ctaLabel: string; ctaVariant: string; ctaHref: string;
    features: PlanFeature[];
  }

  // ── Construye HTML de una tarjeta ─────────────────────────
  function buildCard(plan: PlanOverride, i: number): string {
    const f = plan.featured;
    const cardCls = [
      'pricing-card relative rounded-2xl flex flex-col',
      'transition-all duration-300 ease-out',
      f ? 'shadow-2xl shadow-orange-200 sm:scale-[1.03] sm:hover:scale-[1.05]'
        : 'bg-white border border-usqay-border shadow-sm hover:shadow-xl hover:-translate-y-1',
    ].join(' ');

    const hasSavings = Boolean(plan.annualSavingsLabel) && plan.priceMonthly !== plan.priceAnnual;

    const featuresHTML = plan.features.map(feat => `
      <li class="flex items-start gap-2 sm:gap-2.5 text-xs sm:text-sm leading-snug">
        <span class="flex-shrink-0 mt-0.5 text-sm sm:text-base leading-none ${feat.included ? 'text-usqay-green' : 'text-usqay-subtle'}">${feat.included ? '✓' : '✗'}</span>
        <span class="${feat.included ? 'text-usqay-text font-medium' : 'text-usqay-subtle line-through'}">${feat.label}</span>
      </li>`).join('');

    return `
      <div class="${cardCls}" style="--delay: ${i * 100}ms">
        ${f && plan.featuredLabel ? `
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-white text-usqay-orange text-xs font-black px-4 py-1 rounded-full whitespace-nowrap shadow-lg border border-orange-100">
            ${plan.featuredLabel}
          </div>` : ''}

        <div class="px-4 pt-6 pb-4 sm:px-6 sm:pt-8 sm:pb-6 rounded-t-2xl ${f ? 'bg-gradient-to-br from-usqay-orange to-usqay-orange-dark text-white' : 'bg-white'}">
          <h3 class="text-base sm:text-xl font-black mb-1 ${f ? 'text-white' : 'text-usqay-navy'}" style="font-family:'Playfair Display',serif;">${plan.name}</h3>
          <p class="text-xs leading-relaxed mb-3 sm:mb-5 line-clamp-4 sm:line-clamp-none min-h-[4.9rem] sm:min-h-0 ${f ? 'text-orange-100' : 'text-usqay-muted'}">${plan.description}</p>
          <div class="mb-1">
            <div class="flex items-baseline gap-0.5">
              <span class="plan-original text-sm line-through mr-1 ${f ? 'text-orange-200' : 'text-usqay-subtle'}"
                data-monthly="${plan.priceMonthly}" data-annual="${plan.priceAnnual}" style="display:none">S/${plan.priceMonthly}</span>
              <span class="text-base font-semibold ${f ? 'text-white' : 'text-usqay-navy'}">S/</span>
              <span class="plan-price text-3xl sm:text-5xl font-black leading-none ${f ? 'text-white' : 'text-usqay-navy'}"
                data-monthly="${plan.priceMonthly}" data-annual="${plan.priceAnnual}">${plan.priceMonthly}</span>
              <span class="text-sm ml-1 ${f ? 'text-orange-100' : 'text-usqay-muted'}">/mes</span>
            </div>
            ${hasSavings ? `
            <div class="plan-savings mt-2.5" style="display:none">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-black tracking-wide ${
                f ? 'bg-white/20 text-white border border-white/30'
                  : 'bg-green-100 text-green-700 border border-green-200'
              }">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                </svg>
                ${plan.annualSavingsLabel}
              </span>
            </div>` : ''}
          </div>
        </div>

        <div class="px-4 py-3 sm:px-6 sm:py-4 ${f ? 'bg-usqay-orange-dark' : 'bg-white'}">
          <a href="${plan.ctaHref}" class="block w-full text-center py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 active:scale-95 ${
            f ? 'bg-white text-usqay-orange hover:bg-orange-50 shadow-md'
              : 'bg-usqay-orange text-white hover:bg-usqay-orange-dark shadow-sm hover:shadow-orange-200 hover:shadow-md'
          }">${plan.ctaLabel}</a>
        </div>

        <div class="bg-white flex-1 px-4 pt-4 pb-5 sm:px-6 sm:pt-5 sm:pb-6 rounded-b-2xl">
          <p class="text-[10px] uppercase tracking-widest text-usqay-subtle font-bold mb-3 sm:mb-4">Incluye</p>
          <ul class="space-y-1.5 sm:space-y-2.5">${featuresHTML}</ul>
        </div>
      </div>`;
  }

  // ── IntersectionObserver para animación de entrada ────────
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
    }),
    { threshold: 0.08 }
  );

  function observeCards() {
    document.querySelectorAll<HTMLElement>('.pricing-card').forEach((c) => observer.observe(c));
  }

  // ── Aplicar overrides del admin si existen ────────────────
  const OVERRIDE_KEY = 'usqay_plan_overrides';
  const overridesRaw = localStorage.getItem(OVERRIDE_KEY);

  if (overridesRaw) {
    try {
      const plans: PlanOverride[] = JSON.parse(overridesRaw);
      const grid = document.getElementById('pricing-grid');
      if (grid && plans.length) {
        grid.innerHTML = plans.map((p, i) => buildCard(p, i)).join('');
      }
    } catch { /* si el JSON está corrupto, usa el HTML server-rendered */ }
  }

  observeCards();

  // ── Toggle facturación mensual / anual ────────────────────
  window.addEventListener('billing-change', (e: Event) => {
    const { isAnnual } = (e as CustomEvent).detail as { isAnnual: boolean };
    document.querySelectorAll<HTMLElement>('.plan-price').forEach((el) => {
      el.textContent = isAnnual ? (el.dataset.annual ?? '') : (el.dataset.monthly ?? '');
    });
    document.querySelectorAll<HTMLElement>('.plan-original').forEach((el) => {
      el.style.display = isAnnual ? 'inline' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.plan-savings').forEach((el) => {
      el.style.display = isAnnual ? 'block' : 'none';
    });
  });
</script>
