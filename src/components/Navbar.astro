---
import { SITE } from '@/data/site';
---

<header id="navbar" class="sticky top-0 z-50 bg-white border-b border-usqay-border transition-shadow duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3" aria-label={SITE.name}>
      <img src="/usqay-logo.svg" alt="Usqay logo" class="h-10 w-auto object-contain" width="120" height="40" />
    </a>
    <a
      href="#contacto"
      class="bg-usqay-orange text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-usqay-orange-dark transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-orange-200 active:scale-95"
    >
      Demo gratuita
    </a>
  </div>
</header>

<script is:inline>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('shadow-md', window.scrollY > 10);
  });
</script>
