<section class="bg-usqay-navy-light py-12 sm:py-20 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-6 sm:mb-12">
      <span class="inline-block text-usqay-orange text-xs font-bold uppercase tracking-widest mb-3 px-3 py-1 rounded-full bg-white border border-usqay-orange/20">
        Míranos en acción
      </span>
      <h2
        class="text-2xl sm:text-4xl font-black text-usqay-navy mt-2"
        style="font-family: 'Playfair Display', serif;"
      >
        Descubre cómo funciona Usqay
      </h2>
      <p class="text-usqay-muted text-sm mt-2 sm:mt-3 max-w-xl mx-auto">
        Ve en tiempo real cómo Usqay transforma la gestión de tu negocio.
      </p>
