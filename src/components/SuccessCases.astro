    <div class="relative w-full rounded-2xl overflow-hidden shadow-2xl shadow-usqay-navy/20 border border-white/60"
         style="aspect-ratio: 16/9;">
      <iframe
        src="https://www.youtube.com/embed/DZRT_Qx7108?rel=0&modestbranding=1"
        title="Usqay – Cómo funciona"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        class="absolute inset-0 w-full h-full"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</section>
