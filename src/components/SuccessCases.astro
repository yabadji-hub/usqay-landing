---
import { SUCCESS_CASES } from '@/data/site';
---

<section class="bg-usqay-navy-light py-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <span class="inline-block text-usqay-orange text-xs font-bold uppercase tracking-widest mb-3 px-3 py-1 rounded-full bg-white border border-usqay-orange/20">
        Testimonios reales
      </span>
      <h2
        class="text-3xl sm:text-4xl font-black text-usqay-navy mt-2"
        style="font-family: 'Playfair Display', serif;"
      >
        Lo que dicen nuestros clientes
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        SUCCESS_CASES.map((c) => (
          <div class="bg-white rounded-2xl p-6 flex flex-col gap-4 shadow-sm hover:shadow-lg transition-all duration-300 border border-white hover:border-usqay-orange/20">
            <!-- Estrellas primero — activan emoción positiva -->
            <p class="text-usqay-orange text-base tracking-wide">★★★★★</p>

            <p class="text-sm text-usqay-muted leading-relaxed italic flex-1">"{c.quote}"</p>

            <div class="flex items-center gap-3 pt-2 border-t border-usqay-border">
              <div class={`w-10 h-10 rounded-full flex items-center justify-center text-xs font-black flex-shrink-0 ${c.avatarColor} ${c.textColor}`}>
                {c.initials}
              </div>
              <div>
                <p class="text-sm font-bold text-usqay-navy leading-tight">{c.name}</p>
                <p class="text-xs text-usqay-muted leading-tight mt-0.5">{c.role}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
