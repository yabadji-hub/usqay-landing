---
---

<section class="chef-section relative min-h-screen bg-[#0a0a0a] flex flex-col lg:flex-row items-center justify-center overflow-hidden px-6 sm:px-12 py-16 gap-12">

  <!-- Fondo: glow radial naranja sutil -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
    style="background: radial-gradient(ellipse 60% 60% at 70% 50%, rgba(232,92,26,0.12) 0%, transparent 70%);">
  </div>

  <!-- Grid de puntos decorativa -->
  <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true"
    style="background-image: radial-gradient(circle, rgba(232,92,26,0.4) 1px, transparent 1px); background-size: 36px 36px;">
  </div>

  <!-- ============ TEXTO IZQUIERDA ============ -->
  <div class="relative z-10 flex-1 max-w-lg text-left">
    <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#E85C1A] mb-4 px-3 py-1 rounded-full border border-[#E85C1A]/30 bg-[#E85C1A]/10">
      Sistema profesional
    </span>

    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-6"
>
      Tu restaurante merece un sistema
      <span style="background: linear-gradient(90deg,#E85C1A,#ff9a5e); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
        profesional
      </span>
    </h2>

    <p class="text-gray-400 text-lg leading-relaxed mb-8 max-w-md">
      Deja de perder tiempo con papel y errores. Digitaliza tus pedidos, inventario y facturación hoy mismo.
    </p>

    <a href="#contacto"
      class="inline-flex items-center gap-2 bg-[#E85C1A] text-white font-black text-base px-8 py-4 rounded-2xl hover:bg-[#C44B15] transition-all duration-200 shadow-2xl hover:shadow-orange-500/30 active:scale-95">
      Solicitar demo gratuita
      <span class="text-xl">→</span>
    </a>

    <!-- Trust badges -->
    <div class="flex flex-wrap gap-4 mt-8">
      {['Sin instalación', 'Soporte incluido', 'Cancela cuando quieras'].map(t => (
        <span class="flex items-center gap-1.5 text-xs text-gray-500">
          <span class="text-[#E85C1A]">✓</span> {t}
        </span>
      ))}
    </div>
  </div>

  <!-- ============ CHEF SVG DERECHA ============ -->
  <div class="relative z-10 flex-1 flex items-center justify-center">

    <!-- Sparkles alrededor del chef -->
    <div class="sparkle-container absolute inset-0 pointer-events-none" aria-hidden="true">
      <span class="sparkle" style="top:8%; left:55%; --d:0s; --s:14px;"></span>
      <span class="sparkle" style="top:15%; left:80%; --d:0.4s; --s:10px;"></span>
      <span class="sparkle" style="top:30%; left:88%; --d:0.8s; --s:18px;"></span>
      <span class="sparkle" style="top:60%; left:85%; --d:0.2s; --s:12px;"></span>
      <span class="sparkle" style="top:75%; left:72%; --d:1s; --s:10px;"></span>
      <span class="sparkle" style="top:70%; left:40%; --d:0.6s; --s:16px;"></span>
      <span class="sparkle" style="top:40%; left:38%; --d:1.2s; --s:8px;"></span>
      <span class="sparkle" style="top:10%; left:65%; --d:0.9s; --s:12px;"></span>
    </div>

    <!-- Glow detrás del chef -->
    <div class="absolute rounded-full blur-3xl opacity-30 pointer-events-none"
      style="width:340px;height:340px;background:radial-gradient(circle,#E85C1A,transparent);top:50%;left:50%;transform:translate(-50%,-50%);">
    </div>

    <!-- Chef SVG flotando -->
    <div class="chef-float drop-shadow-2xl">
      <svg viewBox="0 0 400 540" width="380" height="510" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Chef animado Usqay">
        <defs>
          <!-- Base metálica naranja -->
          <linearGradient id="c-metal" x1="15%" y1="0%" x2="85%" y2="100%">
            <stop offset="0%"   stop-color="#FF9B5E"/>
            <stop offset="28%"  stop-color="#E85C1A"/>
            <stop offset="68%"  stop-color="#8B2E06"/>
            <stop offset="100%" stop-color="#D96018"/>
          </linearGradient>

          <!-- Metal más oscuro para sombras -->
          <linearGradient id="c-dark" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%"   stop-color="#C44B15"/>
            <stop offset="100%" stop-color="#6B2004"/>
          </linearGradient>

          <!-- Brillo blanco — toque de casco -->
          <radialGradient id="s-hat" cx="32%" cy="22%" r="52%">
            <stop offset="0%"   stop-color="rgba(255,255,255,0.80)"/>
            <stop offset="35%"  stop-color="rgba(255,255,255,0.18)"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
          </radialGradient>

          <!-- Brillo blanco — cabeza -->
          <radialGradient id="s-head" cx="35%" cy="28%" r="48%">
            <stop offset="0%"   stop-color="rgba(255,255,255,0.85)"/>
            <stop offset="38%"  stop-color="rgba(255,255,255,0.15)"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
          </radialGradient>

          <!-- Brillo blanco — cuerpo -->
          <radialGradient id="s-body" cx="22%" cy="18%" r="62%">
            <stop offset="0%"   stop-color="rgba(255,255,255,0.55)"/>
            <stop offset="45%"  stop-color="rgba(255,255,255,0.08)"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
          </radialGradient>

          <!-- Brillo pequeño — brazos y piernas -->
          <radialGradient id="s-limb" cx="30%" cy="25%" r="55%">
            <stop offset="0%"   stop-color="rgba(255,255,255,0.65)"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
          </radialGradient>

          <!-- Sombra suelo -->
          <radialGradient id="g-floor" cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="rgba(232,92,26,0.35)"/>
            <stop offset="100%" stop-color="rgba(0,0,0,0)"/>
          </radialGradient>

          <!-- Sartén interior -->
          <radialGradient id="s-pan" cx="40%" cy="35%" r="55%">
            <stop offset="0%"   stop-color="rgba(255,200,120,0.6)"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
          </radialGradient>

          <!-- Filtro glow sutil -->
          <filter id="glow-soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="6" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>

          <!-- clip paths -->
          <clipPath id="cp-hat-top"><ellipse cx="200" cy="38" rx="58" ry="20"/></clipPath>
          <clipPath id="cp-hat-body"><rect x="150" y="38" width="100" height="100" rx="20"/></clipPath>
          <clipPath id="cp-brim"><ellipse cx="200" cy="138" rx="76" ry="17"/></clipPath>
          <clipPath id="cp-head"><circle cx="200" cy="192" r="47"/></clipPath>
          <clipPath id="cp-body"><rect x="148" y="242" width="104" height="128" rx="20"/></clipPath>
          <clipPath id="cp-l-upper"><rect x="72" y="245" width="80" height="32" rx="16"/></clipPath>
          <clipPath id="cp-r-upper"><rect x="248" y="245" width="80" height="32" rx="16"/></clipPath>
        </defs>

        <!-- === SOMBRA EN EL SUELO === -->
        <ellipse cx="200" cy="530" rx="100" ry="14" fill="url(#g-floor)" opacity="0.7"/>

        <!-- ===== SOMBRERO (TOQUE) ===== -->
        <!-- Cuerpo alto del sombrero -->
        <rect x="150" y="38" width="100" height="102" rx="20" fill="url(#c-metal)" filter="url(#glow-soft)"/>
        <rect x="150" y="38" width="100" height="102" rx="20" fill="url(#s-hat)" clip-path="url(#cp-hat-body)"/>
        <!-- Borde oscuro en la parte baja del cuerpo -->
        <rect x="150" y="118" width="100" height="22" rx="0" fill="url(#c-dark)" opacity="0.35"/>

        <!-- Domo superior del sombrero -->
        <ellipse cx="200" cy="38" rx="58" ry="20" fill="url(#c-metal)"/>
        <ellipse cx="200" cy="38" rx="58" ry="20" fill="url(#s-hat)" clip-path="url(#cp-hat-top)"/>

        <!-- Ala / brim -->
        <ellipse cx="200" cy="138" rx="76" ry="17" fill="url(#c-metal)"/>
        <ellipse cx="200" cy="138" rx="76" ry="17" fill="url(#s-hat)" clip-path="url(#cp-brim)"/>
        <!-- Sombra debajo del ala -->
        <ellipse cx="200" cy="143" rx="72" ry="10" fill="rgba(0,0,0,0.25)"/>

        <!-- Banda del sombrero -->
        <rect x="150" y="130" width="100" height="10" rx="3" fill="rgba(0,0,0,0.3)"/>
        <rect x="152" y="131" width="96" height="4" rx="2" fill="rgba(255,255,255,0.08)"/>

        <!-- ===== CABEZA ===== -->
        <circle cx="200" cy="192" r="47" fill="url(#c-metal)" filter="url(#glow-soft)"/>
        <circle cx="200" cy="192" r="47" fill="url(#s-head)" clip-path="url(#cp-head)"/>
        <!-- Borde oscuro inferior cabeza (para dar volumen) -->
        <ellipse cx="200" cy="225" rx="43" ry="16" fill="rgba(0,0,0,0.18)"/>

        <!-- Ojos -->
        <circle cx="184" cy="188" r="6" fill="rgba(0,0,0,0.55)"/>
        <circle cx="216" cy="188" r="6" fill="rgba(0,0,0,0.55)"/>
        <!-- Reflejo ojo -->
        <circle cx="186" cy="185" r="2.5" fill="rgba(255,255,255,0.9)"/>
        <circle cx="218" cy="185" r="2.5" fill="rgba(255,255,255,0.9)"/>
        <!-- Sonrisa -->
        <path d="M 182 207 Q 200 223 218 207" stroke="rgba(0,0,0,0.45)" stroke-width="3.5" fill="none" stroke-linecap="round"/>
        <!-- Mejillas rosadas -->
        <circle cx="177" cy="205" r="8" fill="rgba(255,100,50,0.25)"/>
        <circle cx="223" cy="205" r="8" fill="rgba(255,100,50,0.25)"/>

        <!-- ===== CUELLO ===== -->
        <rect x="182" y="234" width="36" height="14" rx="7" fill="url(#c-dark)"/>

        <!-- ===== CUERPO / CHAQUETA ===== -->
        <rect x="148" y="242" width="104" height="130" rx="22" fill="url(#c-metal)" filter="url(#glow-soft)"/>
        <rect x="148" y="242" width="104" height="130" rx="22" fill="url(#s-body)" clip-path="url(#cp-body)"/>
        <!-- Línea central (chaqueta) -->
        <line x1="200" y1="248" x2="200" y2="368" stroke="rgba(0,0,0,0.2)" stroke-width="2.5"/>
        <!-- Botones -->
        <circle cx="200" cy="268" r="4.5" fill="rgba(0,0,0,0.28)"/>
        <circle cx="200" cy="290" r="4.5" fill="rgba(0,0,0,0.28)"/>
        <circle cx="200" cy="312" r="4.5" fill="rgba(0,0,0,0.28)"/>
        <!-- Bolsillo pecho -->
        <rect x="162" y="260" width="22" height="18" rx="5" fill="rgba(0,0,0,0.15)"/>
        <!-- Sombra inferior cuerpo -->
        <rect x="148" y="345" width="104" height="27" rx="0" fill="rgba(0,0,0,0.2)" style="border-radius:0 0 22px 22px;"/>

        <!-- ===== BRAZO IZQUIERDO (con sartén) ===== -->
        <!-- Hombro -->
        <circle cx="143" cy="258" r="20" fill="url(#c-metal)"/>
        <circle cx="143" cy="258" r="20" fill="url(#s-limb)"/>
        <!-- Antebrazo inclinado hacia abajo -->
        <rect x="68" y="268" width="82" height="30" rx="15" fill="url(#c-metal)" transform="rotate(18,109,283)"/>
        <rect x="68" y="268" width="82" height="30" rx="15" fill="url(#s-limb)" transform="rotate(18,109,283)"/>
        <!-- Mano/puño -->
        <circle cx="80" cy="318" r="20" fill="url(#c-metal)"/>
        <circle cx="80" cy="318" r="20" fill="url(#s-limb)"/>

        <!-- ===== SARTÉN ===== -->
        <!-- Mango -->
        <rect x="14" y="305" width="70" height="15" rx="7" fill="url(#c-metal)" transform="rotate(-8,49,312)"/>
        <rect x="14" y="305" width="70" height="15" rx="7" fill="url(#s-limb)" transform="rotate(-8,49,312)"/>
        <!-- Cuerpo sartén -->
        <ellipse cx="18" cy="298" rx="32" ry="24" fill="url(#c-dark)"/>
        <ellipse cx="18" cy="298" rx="32" ry="24" fill="url(#s-pan)"/>
        <!-- Borde sartén -->
        <ellipse cx="18" cy="298" rx="32" ry="24" fill="none" stroke="url(#c-metal)" stroke-width="3"/>
        <!-- Vapor del sartén -->
        <path d="M 8 272 Q 3 255 10 240 Q 17 225 11 210" stroke="rgba(255,255,255,0.22)" stroke-width="3" fill="none" stroke-linecap="round" class="steam"/>
        <path d="M 20 270 Q 15 255 22 242 Q 29 229 23 216" stroke="rgba(255,255,255,0.16)" stroke-width="2.5" fill="none" stroke-linecap="round" class="steam" style="animation-delay:0.4s"/>
        <path d="M 32 274 Q 28 260 35 247" stroke="rgba(255,255,255,0.12)" stroke-width="2" fill="none" stroke-linecap="round" class="steam" style="animation-delay:0.8s"/>

        <!-- ===== BRAZO DERECHO (levantado) ===== -->
        <!-- Hombro -->
        <circle cx="257" cy="258" r="20" fill="url(#c-metal)"/>
        <circle cx="257" cy="258" r="20" fill="url(#s-limb)"/>
        <!-- Brazo subiendo -->
        <rect x="250" y="220" width="78" height="30" rx="15" fill="url(#c-metal)" transform="rotate(-50,289,235)"/>
        <rect x="250" y="220" width="78" height="30" rx="15" fill="url(#s-limb)" transform="rotate(-50,289,235)"/>
        <!-- Mano derecha -->
        <circle cx="318" cy="190" r="20" fill="url(#c-metal)"/>
        <circle cx="318" cy="190" r="20" fill="url(#s-limb)"/>
        <!-- Dedo pulgar levantado (ok) -->
        <rect x="322" y="168" width="14" height="28" rx="7" fill="url(#c-metal)"/>
        <rect x="322" y="168" width="14" height="28" rx="7" fill="url(#s-limb)"/>

        <!-- ===== PIERNAS ===== -->
        <!-- Pierna izquierda -->
        <rect x="158" y="364" width="40" height="95" rx="18" fill="url(#c-metal)" transform="rotate(4,178,411)"/>
        <rect x="158" y="364" width="40" height="95" rx="18" fill="url(#s-limb)" transform="rotate(4,178,411)"/>
        <!-- Pierna derecha -->
        <rect x="202" y="364" width="40" height="95" rx="18" fill="url(#c-metal)" transform="rotate(-4,222,411)"/>
        <rect x="202" y="364" width="40" height="95" rx="18" fill="url(#s-limb)" transform="rotate(-4,222,411)"/>

        <!-- ===== PIES ===== -->
        <ellipse cx="172" cy="456" rx="32" ry="14" fill="url(#c-metal)" transform="rotate(-6,172,456)"/>
        <ellipse cx="172" cy="456" rx="32" ry="14" fill="url(#s-limb)" transform="rotate(-6,172,456)"/>
        <ellipse cx="228" cy="456" rx="32" ry="14" fill="url(#c-metal)" transform="rotate(6,228,456)"/>
        <ellipse cx="228" cy="456" rx="32" ry="14" fill="url(#s-limb)" transform="rotate(6,228,456)"/>

        <!-- ===== RIM LIGHT GLOBAL (borde naranja brillante) ===== -->
        <ellipse cx="200" cy="270" rx="180" ry="260" fill="none" stroke="rgba(232,92,26,0.12)" stroke-width="18"/>
      </svg>
    </div>
  </div>
</section>

<style>
  /* ======= FLOAT DEL CHEF ======= */
  .chef-float {
    animation: chef-float 4.5s ease-in-out infinite;
    filter: drop-shadow(0 40px 60px rgba(232,92,26,0.35));
  }

  @keyframes chef-float {
    0%, 100% { transform: translateY(0px) rotate(-1.5deg); }
    50%       { transform: translateY(-22px) rotate(1.5deg); }
  }

  /* ======= VAPOR ======= */
  .steam {
    animation: steam-rise 2.5s ease-in-out infinite;
    transform-origin: bottom center;
  }

  @keyframes steam-rise {
    0%   { opacity: 0; transform: translateY(0) scaleX(1); }
    30%  { opacity: 1; }
    100% { opacity: 0; transform: translateY(-18px) scaleX(1.3); }
  }

  /* ======= SPARKLES ======= */
  .sparkle {
    position: absolute;
    width: var(--s, 12px);
    height: var(--s, 12px);
    animation: sparkle-pulse 2.8s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }

  .sparkle::before,
  .sparkle::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #E85C1A;
    border-radius: 50%;
  }

  .sparkle::before {
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    background: #ff9a5e;
  }

  .sparkle::after {
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    background: #E85C1A;
    transform: rotate(20deg) scale(0.6);
    opacity: 0.6;
  }

  @keyframes sparkle-pulse {
    0%, 100% { opacity: 0; transform: scale(0.4) rotate(0deg); }
    40%, 60% { opacity: 1; transform: scale(1) rotate(180deg); }
  }
</style>
