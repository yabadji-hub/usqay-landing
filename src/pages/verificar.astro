---
import { SITE } from '@/data/site';
---
<!doctype html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verificar correo — {SITE.name}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="min-h-screen bg-[#1B3D6E] flex items-center justify-center p-4" style="font-family:'DM Sans',sans-serif;">

  <div class="w-full max-w-md">
    <div class="bg-white rounded-3xl shadow-2xl p-8 text-center">

      <!-- Estado: cargando -->
      <div id="state-loading">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-50 mb-5">
          <svg class="w-8 h-8 text-blue-500 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </div>
        <h1 class="text-xl font-bold text-[#1B3D6E]">Verificando tu correo...</h1>
        <p class="text-gray-400 text-sm mt-2">Un momento, por favor.</p>
      </div>

      <!-- Estado: éxito -->
      <div id="state-success" class="hidden">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-green-50 mb-5">
          <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h1 class="text-2xl font-black text-[#1B3D6E] mb-2">¡Correo verificado!</h1>
        <p id="success-name" class="text-gray-500 text-sm mb-1"></p>
        <p class="text-gray-400 text-sm mb-6">Tu cuenta ha sido activada correctamente.</p>
        <a href="/admin"
          class="inline-block w-full bg-[#E85C1A] text-white font-bold py-3 rounded-2xl hover:bg-[#C44B15] transition-all active:scale-95 text-sm">
          Ir al panel de administración →
        </a>
      </div>

      <!-- Estado: error -->
      <div id="state-error" class="hidden">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-red-50 mb-5">
          <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </div>
        <h1 class="text-xl font-bold text-gray-900 mb-2">Enlace inválido</h1>
        <p id="error-msg" class="text-gray-500 text-sm mb-6">El enlace de verificación no es válido o ha expirado.</p>
        <a href="/"
          class="inline-block w-full border border-gray-200 text-gray-600 font-semibold py-3 rounded-2xl hover:bg-gray-50 transition-all text-sm">
          Volver al inicio
        </a>
      </div>

    </div>
    <p class="text-center text-white/40 text-xs mt-6">{SITE.name} · Panel de administración</p>
  </div>

</body>
</html>

<script>
  import { verifyAdminUserToken } from '@/lib/supabase';

  const params = new URLSearchParams(window.location.search);
  const token  = params.get('t');

  async function run() {
    const loading = document.getElementById('state-loading')!;
    const success = document.getElementById('state-success')!;
    const error   = document.getElementById('state-error')!;
    const errMsg  = document.getElementById('error-msg')!;

    if (!token) {
      loading.classList.add('hidden');
      errMsg.textContent = 'No se proporcionó un token de verificación.';
      error.classList.remove('hidden');
      return;
    }

    const { user, error: err } = await verifyAdminUserToken(token);

    loading.classList.add('hidden');
    if (err || !user) {
      errMsg.textContent = err ?? 'Token inválido.';
      error.classList.remove('hidden');
    } else {
      const nameEl = document.getElementById('success-name')!;
      nameEl.textContent = `Bienvenido/a, ${user.nombre} (${user.email})`;
      success.classList.remove('hidden');
    }
  }

  run();
</script>
