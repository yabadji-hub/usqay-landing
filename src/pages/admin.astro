---
import { SITE, PLANS } from '@/data/site';
const siteName  = SITE.name;
const plansJSON = JSON.stringify(PLANS);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — {siteName}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="noindex, nofollow" />
  <!-- Default plans embedded for client JS -->
  <script id="default-plans" type="application/json" is:inline set:html={plansJSON}></script>
</head>
<body class="bg-gray-50 min-h-screen antialiased" style="font-family: 'DM Sans', sans-serif;">

  <!-- ── LOGIN OVERLAY ────────────────────────────────────── -->
  <div id="login-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-[#1B3D6E]">
    <div class="w-full max-w-sm mx-4">
      <div class="bg-white rounded-3xl shadow-2xl p-8">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-[#E85C1A] mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-[#1B3D6E]">Panel Administrador</h1>
          <p class="text-gray-500 text-sm mt-1">Usqay — Acceso restringido</p>
        </div>
        <form id="login-form" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Contraseña</label>
            <input type="password" id="admin-password" autocomplete="current-password" placeholder="••••••••"
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#E85C1A] focus:border-transparent transition-all" />
            <p id="login-error" class="hidden mt-2 text-xs text-red-500">Contraseña incorrecta. Inténtalo de nuevo.</p>
          </div>
          <button type="submit" class="w-full bg-[#E85C1A] text-white font-bold py-3 rounded-xl hover:bg-[#C44B15] transition-all active:scale-95">
            Ingresar al panel
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- ── DASHBOARD ────────────────────────────────────────── -->
  <div id="dashboard" class="hidden min-h-screen">

    <!-- Topbar -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#E85C1A] flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"/>
            </svg>
          </div>
          <div>
            <span class="font-bold text-[#1B3D6E] text-sm">Usqay Admin</span>
            <span class="text-gray-400 text-xs ml-2" id="current-date"></span>
            <span id="db-status-badge" class="hidden ml-2 text-xs font-semibold px-2 py-0.5 rounded-full"></span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="/" target="_blank" class="hidden sm:flex items-center gap-1.5 text-xs font-medium text-gray-600 hover:text-[#E85C1A] transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            Ver landing
          </a>
          <button id="logout-btn" class="flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-red-500 transition-colors px-3 py-2 rounded-lg hover:bg-red-50">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Salir
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">

      <div>
        <h1 class="text-2xl font-bold text-[#1B3D6E]">Panel de administración</h1>
        <p class="text-gray-500 text-sm mt-1">Métricas de visitas, formularios y gestión de planes.</p>
      </div>

      <!-- ── METRIC CARDS ── -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div id="card-visits-today" class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm cursor-pointer hover:shadow-md hover:border-blue-200 transition-all group" title="Clic para ver IPs">
          <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center group-hover:bg-blue-100 transition-colors">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </div>
            <span class="text-xs text-blue-400 font-medium group-hover:text-blue-600 transition-colors">Hoy · ver IPs →</span>
          </div>
          <p class="text-3xl font-bold text-gray-900" id="visits-today">0</p>
          <p class="text-sm text-gray-500 mt-0.5">Visitantes únicos hoy</p>
          <p class="text-xs text-gray-400 mt-1">La página fue vista <span id="pageviews-today">0</span> veces</p>
        </div>
        <div id="card-visits-total" class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm cursor-pointer hover:shadow-md hover:border-purple-200 transition-all group" title="Clic para ver todas las IPs">
          <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center group-hover:bg-purple-100 transition-colors">
              <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            </div>
            <span class="text-xs text-purple-400 font-medium group-hover:text-purple-600 transition-colors">Total · ver IPs →</span>
          </div>
          <p class="text-3xl font-bold text-gray-900" id="visits-total">0</p>
          <p class="text-sm text-gray-500 mt-0.5">Visitantes únicos</p>
          <p class="text-xs text-gray-400 mt-1">La página fue vista <span id="pageviews-total">0</span> veces</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm">
          <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <span class="text-xs text-green-600 font-medium bg-green-50 px-2 py-0.5 rounded-full" id="forms-badge">Leads</span>
          </div>
          <p class="text-3xl font-bold text-gray-900" id="forms-count">0</p>
          <p class="text-sm text-gray-500 mt-1">Formularios enviados</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm">
          <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-[#E85C1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
            </div>
            <span class="text-xs text-[#E85C1A] font-medium">Conversión</span>
          </div>
          <p class="text-3xl font-bold text-gray-900" id="conversion-rate">0%</p>
          <p class="text-sm text-gray-500 mt-1">Tasa de conversión</p>
        </div>
      </div>

      <!-- ── SUBMISSIONS TABLE ── -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
        <div class="px-6 py-5 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-[#1B3D6E]">Formularios enviados</h2>
            <p class="text-xs text-gray-400 mt-0.5">Leads captados desde la landing page</p>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <input id="search-input" type="text" placeholder="Buscar por nombre, email..."
              class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#E85C1A] w-44" />
            <button id="report-btn"
              class="flex items-center gap-1.5 text-xs font-semibold text-[#E85C1A] border border-[#E85C1A] px-3 py-2 rounded-lg hover:bg-orange-50 transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              Ver Reporte
            </button>
            <button id="export-btn" class="flex items-center gap-1.5 text-xs font-semibold text-white bg-[#1B3D6E] px-3 py-2 rounded-lg hover:bg-[#1B3D6E]/90 transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Exportar CSV
            </button>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wider">
              <tr>
                <th class="px-6 py-3 text-left font-semibold">#</th>
                <th class="px-6 py-3 text-left font-semibold">Nombre</th>
                <th class="px-6 py-3 text-left font-semibold">WhatsApp</th>
                <th class="px-6 py-3 text-left font-semibold">Email</th>
                <th class="px-6 py-3 text-left font-semibold">Tipo negocio</th>
                <th class="px-6 py-3 text-left font-semibold">Mensaje</th>
                <th class="px-6 py-3 text-left font-semibold">Fecha</th>
                <th class="px-6 py-3 text-left font-semibold">Estado</th>
              </tr>
            </thead>
            <tbody id="submissions-tbody" class="divide-y divide-gray-100"></tbody>
          </table>
          <div id="empty-state" class="hidden py-16 text-center">
            <div class="text-4xl mb-3">📋</div>
            <p class="text-gray-500 text-sm font-medium">Aún no hay formularios enviados</p>
            <p class="text-gray-400 text-xs mt-1">Cuando alguien complete el formulario, aparecerá aquí.</p>
          </div>
        </div>
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
          <p class="text-xs text-gray-400" id="table-summary">0 registros</p>
          <button id="clear-data-btn" class="text-xs text-red-400 hover:text-red-600 transition-colors hover:underline">
            Limpiar datos de prueba
          </button>
        </div>
      </div>

      <!-- ── PLAN EDITOR ── -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

        <!-- Header -->
        <div class="px-6 py-5 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-[#1B3D6E]">Editor de planes de precios</h2>
            <p class="text-xs text-gray-400 mt-0.5">Cambia precios, descuentos y características. Guarda y descarga el archivo actualizado.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button id="add-plan-btn"
              class="flex items-center gap-1 text-xs font-semibold text-[#E85C1A] border border-[#E85C1A] px-3 py-2 rounded-lg hover:bg-orange-50 transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              Nuevo plan
            </button>
            <button id="reset-plans-btn"
              class="text-xs font-semibold text-gray-500 border border-gray-200 px-3 py-2 rounded-lg hover:bg-gray-50 transition-all">
              Restaurar defaults
            </button>
            <button id="download-config-btn"
              class="flex items-center gap-1 text-xs font-semibold text-[#1B3D6E] border border-[#1B3D6E] px-3 py-2 rounded-lg hover:bg-blue-50 transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              Descargar site.ts
            </button>
            <button id="save-plans-btn"
              class="flex items-center gap-1 text-xs font-semibold text-white bg-[#E85C1A] px-4 py-2 rounded-lg hover:bg-[#C44B15] transition-all active:scale-95">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Guardar cambios
            </button>
          </div>
        </div>

        <!-- Discount bars -->
        <div class="border-b border-orange-100 divide-y divide-orange-50">

          <!-- Row 1: Descuento anual -->
          <div class="px-6 py-3 bg-[#FFF7F3] flex flex-wrap items-center gap-3">
            <span class="text-xs font-bold text-[#E85C1A] w-32 flex-shrink-0">🏷️ Desc. anual:</span>
            <div class="flex items-center gap-1.5">
              <input id="global-discount" type="number" min="0" max="100" value="13" placeholder="13"
                class="w-16 border border-orange-200 rounded-lg px-2 py-1.5 text-sm text-center font-bold focus:outline-none focus:ring-2 focus:ring-[#E85C1A]" />
              <span class="text-sm text-gray-600 font-semibold">%</span>
            </div>
            <div class="relative" id="discount-plan-selector">
              <button id="plan-selector-btn" type="button"
                class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 bg-white border border-gray-300 px-3 py-1.5 rounded-lg hover:border-[#E85C1A] hover:text-[#E85C1A] transition-all">
                <span id="plan-selector-label">Todos los planes</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div id="plan-selector-dropdown"
                class="hidden absolute top-full left-0 mt-1.5 bg-white border border-gray-200 rounded-2xl shadow-xl p-2 z-30 min-w-[200px]">
                <label class="flex items-center gap-2.5 px-3 py-2 rounded-xl cursor-pointer hover:bg-orange-50 transition-colors">
                  <input type="checkbox" id="select-all-plans" checked class="w-4 h-4 rounded" style="accent-color:#E85C1A;" />
                  <span class="text-xs font-bold text-gray-800">Todos los planes</span>
                </label>
                <div class="border-t border-gray-100 my-1 mx-2"></div>
                <div id="plan-checkboxes-list" class="space-y-0.5"></div>
              </div>
            </div>
            <button id="apply-discount-btn"
              class="text-xs font-bold text-white bg-[#E85C1A] px-3 py-1.5 rounded-lg hover:bg-[#C44B15] transition-all active:scale-95">
              Aplicar →
            </button>
            <span class="text-xs text-gray-400">Modifica el <strong>precio anual</strong> /mes · fórmula: mensual × (1 − %/100)</span>
          </div>

          <!-- Row 2: Descuento mensual -->
          <div class="px-6 py-3 bg-blue-50/40 flex flex-wrap items-center gap-3">
            <span class="text-xs font-bold text-blue-600 w-32 flex-shrink-0">💰 Desc. mensual:</span>
            <div class="flex items-center gap-1.5">
              <input id="monthly-discount" type="number" min="0" max="100" value="0" placeholder="0"
                class="w-16 border border-blue-200 rounded-lg px-2 py-1.5 text-sm text-center font-bold focus:outline-none focus:ring-2 focus:ring-blue-400" />
              <span class="text-sm text-gray-600 font-semibold">%</span>
            </div>
            <div class="relative" id="monthly-plan-selector">
              <button id="monthly-plan-selector-btn" type="button"
                class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 bg-white border border-gray-300 px-3 py-1.5 rounded-lg hover:border-blue-400 hover:text-blue-600 transition-all">
                <span id="monthly-plan-selector-label">Todos los planes</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div id="monthly-plan-selector-dropdown"
                class="hidden absolute top-full left-0 mt-1.5 bg-white border border-gray-200 rounded-2xl shadow-xl p-2 z-30 min-w-[200px]">
                <label class="flex items-center gap-2.5 px-3 py-2 rounded-xl cursor-pointer hover:bg-blue-50 transition-colors">
                  <input type="checkbox" id="select-all-monthly-plans" checked class="w-4 h-4 rounded" style="accent-color:#2563eb;" />
                  <span class="text-xs font-bold text-gray-800">Todos los planes</span>
                </label>
                <div class="border-t border-gray-100 my-1 mx-2"></div>
                <div id="monthly-plan-checkboxes-list" class="space-y-0.5"></div>
              </div>
            </div>
            <button id="apply-monthly-discount-btn"
              class="text-xs font-bold text-white bg-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-700 transition-all active:scale-95">
              Aplicar →
            </button>
            <span class="text-xs text-gray-400">Modifica el <strong>precio mensual</strong> · fórmula: precio base × (1 − %/100)</span>
          </div>

        </div>

        <!-- Plans grid -->
        <div id="plans-editor-grid" class="p-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
          <!-- JS rendered -->
        </div>

        <div class="px-6 py-4 border-t border-gray-100 bg-gray-50">
          <p class="text-xs text-gray-500">
            💡 <strong>Para publicar los cambios:</strong> haz clic en
            <strong>Guardar cambios</strong> (se guarda en este navegador) y luego
            <strong>Descargar site.ts</strong> → reemplaza el archivo en
            <code>src/data/site.ts</code> → ejecuta <code>npm run build</code>.
          </p>
        </div>
      </div>

      <!-- ── BACKEND SQL (Supabase) ── -->
      <div id="backend-section" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
              </svg>
            </div>
            <div>
              <h2 class="text-base font-bold text-[#1B3D6E]">Backend SQL — Supabase (PostgreSQL)</h2>
              <p class="text-xs text-gray-400 mt-0.5">Base de datos escalable multiusuario. Estado: <span id="backend-status-text" class="font-semibold">verificando...</span></p>
            </div>
          </div>
          <div id="backend-connected-badge" class="hidden flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-full">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Conectado
          </div>
