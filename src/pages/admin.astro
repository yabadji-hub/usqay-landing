  );

  clearDbConfirmBtn.addEventListener('click', async () => {
    if (clearDbPassword.value !== ADMIN_PASSWORD) {
      clearDbError.classList.remove('hidden');
      clearDbPassword.value = '';
      clearDbPassword.focus();
      return;
    }
    clearDbError.classList.add('hidden');
    clearDbConfirmBtn.textContent = 'Limpiando...';
    clearDbConfirmBtn.setAttribute('disabled', 'true');

    try {
      const errors: string[] = [];

      if (pendingClearTarget === 'visits' || pendingClearTarget === 'all') {
        const { error } = await clearVisits();
        if (error) errors.push(`Visitas: ${error}`);
        else {
          localStorage.removeItem('usqay_visit_log');
          localStorage.removeItem('usqay_visits_total');
          localStorage.removeItem('usqay_visits_day');
        }
      }

      if (pendingClearTarget === 'leads' || pendingClearTarget === 'all') {
        const { error } = await clearSubmissions();
        if (error) errors.push(`Leads: ${error}`);
        else {
          localStorage.removeItem('usqay_submissions');
        }
      }

      clearDbModal.classList.add('hidden');

      if (errors.length) {
        alert(`Error al limpiar:\n${errors.join('\n')}`);
      } else {
        const labels: Record<ClearTarget, string> = {
          visits: 'Visitas eliminadas de la DB',
          leads:  'Leads eliminados de la DB',
          all:    'Base de datos y datos locales limpiados',
        };
        showToast(labels[pendingClearTarget]);
        // Refresh metrics and table
        loadMetrics();
        renderTable('');
        await initBackendSection();
      }
    } finally {
      clearDbConfirmBtn.textContent = 'Confirmar y limpiar';
      clearDbConfirmBtn.removeAttribute('disabled');
    }
  });

  // Toast helper
  let toastTimer: ReturnType<typeof setTimeout> | null = null;
