  // ── Visit Log Modal (IPs) ─────────────────────────────────
  const visitModal      = document.getElementById('visit-modal')!;
  const visitLogTbody   = document.getElementById('visit-log-tbody')!;
  const visitLogEmpty   = document.getElementById('visit-log-empty')!;
  const visitModalSub   = document.getElementById('visit-modal-subtitle')!;
  const visitSummaryEl  = document.getElementById('visit-modal-summary')!;
  const ipSearchInput   = document.getElementById('ip-search') as HTMLInputElement | null;
  const exportIpsBtn    = document.getElementById('export-ips-btn')!;

  interface VisitRecord {
    ip: string; country: string; city: string; region: string;
    isp: string; device: string; browser: string; timestamp: string; page: string;
  }

  function getVisitLog(): VisitRecord[] {
    try { return JSON.parse(localStorage.getItem('usqay_visit_log') ?? '[]'); } catch { return []; }
  }

  function openVisitModal(filterToday: boolean) {
    const all  = getVisitLog();
    const today = new Date().toISOString().slice(0, 10);
    const list  = filterToday
      ? all.filter(v => v.timestamp?.slice(0, 10) === today)
      : all;

    const uniqueInList = new Set(list.map(v => v.ip).filter(Boolean)).size;
    visitModalSub.textContent = filterToday
      ? `Hoy: ${list.length} páginas vistas · ${uniqueInList} IPs únicas`
      : `Total: ${all.length} páginas vistas · ${new Set(all.map(v => v.ip).filter(Boolean)).size} IPs únicas`;

    renderVisitLog(list, all);
    buildSummary(list);
    visitModal.classList.remove('hidden');
  }

  function renderVisitLog(list: VisitRecord[], _all: VisitRecord[]) {
    if (!list.length) {
      visitLogTbody.innerHTML = '';
      visitLogEmpty.classList.remove('hidden');
    } else {
      visitLogEmpty.classList.add('hidden');
      const deviceIcon = (d: string) =>
        d === 'Móvil' ? '📱' : d === 'Tablet' ? '📟' : '🖥️';
      const browserIcon = (b: string) =>
        ({ Chrome:'🟡', Firefox:'🟠', Safari:'🔵', Edge:'🔷' })[b] ?? '🌐';

      visitLogTbody.innerHTML = list.map((v, i) => `
        <tr class="hover:bg-blue-50/40 transition-colors">
          <td class="px-5 py-3 text-gray-400 text-xs font-mono">${i + 1}</td>
          <td class="px-5 py-3">
            <code class="text-xs font-mono bg-gray-100 px-2 py-1 rounded-lg text-gray-800 select-all">${esc(v.ip)}</code>
          </td>
          <td class="px-5 py-3 text-sm text-gray-700 whitespace-nowrap">${esc(v.country || '—')}</td>
          <td class="px-5 py-3 text-sm text-gray-600 whitespace-nowrap">${esc(v.city || '—')}</td>
          <td class="px-5 py-3 text-xs text-gray-500 max-w-[160px] truncate hidden sm:table-cell">${esc(v.isp || '—')}</td>
          <td class="px-5 py-3 text-sm whitespace-nowrap">${deviceIcon(v.device)} ${esc(v.device || '—')}</td>
          <td class="px-5 py-3 text-sm whitespace-nowrap hidden md:table-cell">${browserIcon(v.browser)} ${esc(v.browser || '—')}</td>
          <td class="px-5 py-3 text-xs text-gray-400 whitespace-nowrap">${fmtDate(v.timestamp)}</td>
        </tr>`).join('');
    }
  }

  function buildSummary(list: VisitRecord[]) {
    if (!list.length) { visitSummaryEl.innerHTML = ''; return; }
    const countries = [...new Set(list.map(v => v.country).filter(Boolean))].slice(0, 4).join(', ') || '—';
    const mobiles   = list.filter(v => v.device === 'Móvil').length;
    const desktops  = list.filter(v => v.device === 'Escritorio').length;
    const uniqIPs   = new Set(list.map(v => v.ip)).size;
    visitSummaryEl.innerHTML = `
      <span>🌍 Países: <strong>${countries}</strong></span>
      <span>📱 Móvil: <strong>${mobiles}</strong></span>
      <span>🖥️ Escritorio: <strong>${desktops}</strong></span>
      <span>🔑 IPs únicas: <strong>${uniqIPs}</strong></span>`;
  }

  function filterVisits(query: string) {
    const all   = getVisitLog();
    const q     = query.toLowerCase().trim();
    const list  = q
      ? all.filter(v =>
          v.ip?.includes(q) || v.country?.toLowerCase().includes(q) ||
          v.city?.toLowerCase().includes(q) || v.isp?.toLowerCase().includes(q))
      : all;
    renderVisitLog(list, all);
    buildSummary(list);
    visitModalSub.textContent = q ? `${list.length} resultado(s) para "${query}"` : `Todas las visitas (${all.length})`;
  }

  document.getElementById('card-visits-today')!.addEventListener('click', () => openVisitModal(true));
  document.getElementById('card-visits-total')!.addEventListener('click', () => openVisitModal(false));
  document.getElementById('close-visit-modal')!.addEventListener('click', () => visitModal.classList.add('hidden'));
  visitModal.addEventListener('click', (e) => { if (e.target === visitModal) visitModal.classList.add('hidden'); });

  ipSearchInput?.addEventListener('input', () => filterVisits(ipSearchInput.value));

  exportIpsBtn.addEventListener('click', () => {
    const list = getVisitLog();
    if (!list.length) { alert('No hay visitas registradas.'); return; }
    const headers = ['#','IP','País','Ciudad','Región','ISP','Dispositivo','Navegador','Fecha'];
    const rows = list.map((v, i) => [i+1, v.ip, v.country, v.city, v.region, v.isp, v.device, v.browser, v.timestamp]);
    const csv = [headers,...rows].map(r => r.map(c=>`"${String(c??'').replace(/"/g,'""')}"`).join(',')).join('\r\n');
    const url = URL.createObjectURL(new Blob(['﻿'+csv],{type:'text/csv;charset=utf-8;'}));
    Object.assign(document.createElement('a'),{href:url,download:`usqay-ips-${new Date().toISOString().slice(0,10)}.csv`}).click();
    URL.revokeObjectURL(url);
  });

  // ── Report Modal ──────────────────────────────────────────
  const reportModal  = document.getElementById('report-modal')!;
  const reportBtn    = document.getElementById('report-btn')!;
  const closeReportBtn = document.getElementById('close-report-btn')!;
  const printReportBtn = document.getElementById('print-report-btn')!;

  const TIPO_LABELS: Record<string,string> = {
    restaurante: 'Restaurante', polleria: 'Pollería', cevicheria: 'Cevichería',
    chifa: 'Chifa', 'fuente-de-soda': 'Fuente de soda', otro: 'Otro',
  };
  const TYPE_COLORS = ['#E85C1A','#1B3D6E','#16a34a','#7c3aed','#0891b2','#be185d'];

  reportBtn.addEventListener('click', openReport);
  closeReportBtn.addEventListener('click', () => reportModal.classList.add('hidden'));
  printReportBtn.addEventListener('click', () => window.print());

  function openReport() {
    const subs = getSubmissions();
    const now  = new Date();

    // Date labels
    const dateStr = now.toLocaleDateString('es-PE', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
    setText('report-date', `Generado el ${dateStr}`);
    setText('report-footer-date', dateStr);

    // Summary counts
    const weekAgo = new Date(now.getTime() - 7 * 86400000);
    const thisWeek = subs.filter(s => new Date(s.fecha) >= weekAgo).length;
    const nuevos   = subs.filter(s => !s.estado || s.estado === 'Nuevo').length;
    const contactados = subs.filter(s => s.estado === 'Contactado').length;

    setText('r-total',     String(subs.length));
    setText('r-week',      String(thisWeek));
    setText('r-new',       String(nuevos));
    setText('r-contacted', String(contactados));

    // Chart: by business type
    renderChartByType(subs);

    // Chart: by day
    renderChartByDay(subs);

    // Leads cards
    renderLeadCards(subs);

    reportModal.classList.remove('hidden');
    reportModal.scrollTop = 0;
  }

  function renderChartByType(subs: Submission[]) {
    const container = document.getElementById('chart-by-type')!;
    const emptyEl   = document.getElementById('chart-by-type-empty')!;
    if (!subs.length) { container.innerHTML = ''; emptyEl.classList.remove('hidden'); return; }
    emptyEl.classList.add('hidden');

    const counts: Record<string, number> = {};
    subs.forEach(s => {
      const k = s.tipo_negocio || 'otro';
      counts[k] = (counts[k] || 0) + 1;
    });

    const sorted = Object.entries(counts).sort((a,b) => b[1] - a[1]);
    const max = sorted[0]?.[1] ?? 1;

    container.innerHTML = sorted.map(([tipo, count], i) => {
      const pct  = Math.round((count / max) * 100);
      const label = TIPO_LABELS[tipo] ?? tipo;
      const color = TYPE_COLORS[i % TYPE_COLORS.length];
      return `
        <div class="flex items-center gap-3">
          <span class="text-xs text-gray-600 w-28 text-right flex-shrink-0 font-medium">${label}</span>
          <div class="flex-1 bg-gray-100 rounded-full h-7 overflow-hidden">
            <div class="h-full rounded-full flex items-center px-3 transition-all duration-700"
              style="width:${pct}%; background:${color}; min-width:2.5rem;">
              <span class="text-white text-xs font-bold">${count}</span>
            </div>
          </div>
          <span class="text-xs text-gray-400 w-8 text-right">${Math.round(count/subs.length*100)}%</span>
        </div>`;
    }).join('');
  }

  function renderChartByDay(subs: Submission[]) {
    const container = document.getElementById('chart-by-day')!;
    const emptyEl   = document.getElementById('chart-by-day-empty')!;
    if (!subs.length) { container.innerHTML = ''; emptyEl.classList.remove('hidden'); return; }
    emptyEl.classList.add('hidden');

    // Build last 7 days
    const days: {date:string; label:string; count:number}[] = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      const key   = d.toISOString().slice(0, 10);
      const label = d.toLocaleDateString('es-PE', { weekday:'short', day:'numeric' });
      const count = subs.filter(s => s.fecha?.slice(0, 10) === key).length;
      days.push({ date: key, label, count });
    }

    const maxCount = Math.max(...days.map(d => d.count), 1);
    const W = 320, H = 160, padX = 8, padY = 24, barW = (W - padX*2) / days.length;

    const bars = days.map((d, i) => {
      const barH  = d.count === 0 ? 3 : Math.round((d.count / maxCount) * (H - padY - 20));
      const x     = padX + i * barW + barW * 0.15;
      const y     = H - padY - barH;
      const color = d.count === 0 ? '#e5e7eb' : '#E85C1A';
      return `
        <rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${(barW*0.7).toFixed(1)}" height="${barH}" rx="5" fill="${color}" opacity="0.9"/>
        <text x="${(x + barW*0.35).toFixed(1)}" y="${(H - 6).toFixed(1)}" text-anchor="middle" font-size="9" fill="#9ca3af" font-family="DM Sans,sans-serif">${d.label}</text>
        ${d.count > 0 ? `<text x="${(x+barW*0.35).toFixed(1)}" y="${(y-5).toFixed(1)}" text-anchor="middle" font-size="10" fill="#1B3D6E" font-weight="bold" font-family="DM Sans,sans-serif">${d.count}</text>` : ''}`;
    }).join('');

    container.innerHTML = `<svg viewBox="0 0 ${W} ${H}" class="w-full">${bars}</svg>`;
  }

  function renderLeadCards(subs: Submission[]) {
    const grid    = document.getElementById('leads-cards-grid')!;
    const emptyEl = document.getElementById('leads-cards-empty')!;
    if (!subs.length) { grid.innerHTML = ''; emptyEl.classList.remove('hidden'); return; }
    emptyEl.classList.add('hidden');

    const avatarColors = ['#1B3D6E','#E85C1A','#16a34a','#7c3aed','#0891b2','#be185d','#b45309'];
    const statusBadge: Record<string,string> = {
      'Nuevo':          'background:#dcfce7;color:#15803d;',
      'Contactado':     'background:#dbeafe;color:#1d4ed8;',
      'En seguimiento': 'background:#ffedd5;color:#c2410c;',
      'Cerrado':        'background:#f3f4f6;color:#374151;',
    };

    grid.innerHTML = subs.slice().reverse().map((s, i) => {
      const initial = (s.nombre || '?').charAt(0).toUpperCase();
      const color   = avatarColors[i % avatarColors.length];
      const estado  = s.estado || 'Nuevo';
      const tipo    = TIPO_LABELS[s.tipo_negocio] ?? s.tipo_negocio ?? '—';
      return `
        <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0"
                style="background:${color};">${initial}</div>
              <div>
                <p class="font-bold text-gray-900 text-sm leading-tight">${esc(s.nombre)}</p>
                <p class="text-xs text-gray-400 mt-0.5">${fmtDate(s.fecha)}</p>
              </div>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full flex-shrink-0" style="${statusBadge[estado] ?? statusBadge['Nuevo']}">${estado}</span>
          </div>

          <div class="space-y-1.5 mb-3">
            <div class="flex items-center gap-2 text-xs text-gray-600">
              <span class="text-base">📱</span>
              <a href="https://wa.me/${s.telefono.replace(/\D/g,'')}" target="_blank" class="hover:text-[#E85C1A] transition-colors underline-offset-2 hover:underline">${esc(s.telefono)}</a>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-600">
              <span class="text-base">✉️</span>
              <a href="mailto:${esc(s.email)}" class="hover:text-[#E85C1A] transition-colors truncate underline-offset-2 hover:underline">${esc(s.email)}</a>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-600">
              <span class="text-base">🏪</span>
              <span class="capitalize">${esc(tipo)}</span>
            </div>
          </div>

          ${s.mensaje ? `<p class="text-xs text-gray-500 bg-gray-50 rounded-xl px-3 py-2 italic border-l-2 border-[#E85C1A]/40">"${esc(s.mensaje)}"</p>` : ''}
        </div>`;
    }).join('');
  }
</script>
