  // ── Types ─────────────────────────────────────────────────
  interface Feature  { label: string; included: boolean; }
  interface PlanData { id:string; name:string; emoji:string; featured:boolean; featuredLabel:string; description:string; priceMonthly:number; priceAnnual:number; annualSavingsLabel:string; ctaLabel:string; ctaVariant:string; ctaHref:string; features:Feature[]; }

  // ── Constants ─────────────────────────────────────────────
  const ADMIN_PASSWORD  = 'usqay2026';
  const SESSION_KEY     = 'usqay_admin_session';
  const VISITS_KEY      = 'usqay_visits_total';
  const VISITS_DAY_KEY  = 'usqay_visits_day';
  const SUBS_KEY        = 'usqay_submissions';
  const PLANS_OVERRIDE  = 'usqay_plan_overrides';
  const DB_STATUS_KEY   = 'usqay_db_status';

  // ── Mutable state (debe estar antes de showDashboard) ─────
  let editingPlans: PlanData[] = [];

  // ── Elements ──────────────────────────────────────────────
  const loginOverlay = document.getElementById('login-overlay')!;
  const dashboard    = document.getElementById('dashboard')!;
  const loginForm    = document.getElementById('login-form')!;
  const loginError   = document.getElementById('login-error')!;
  const logoutBtn    = document.getElementById('logout-btn')!;
  const searchInput  = document.getElementById('search-input') as HTMLInputElement;
  const exportBtn    = document.getElementById('export-btn')!;
  const clearBtn     = document.getElementById('clear-data-btn')!;

  // ── Login ─────────────────────────────────────────────────
  function showDashboard() {
    loginOverlay.classList.add('hidden');
    dashboard.classList.remove('hidden');
    loadMetrics();
    renderTable('');
    renderPlanEditor();
    initBackendSection();
    const el = document.getElementById('current-date');
    if (el) el.textContent = new Date().toLocaleDateString('es-PE', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
  }

  // ── Actualizar estado del backend inmediatamente (síncrono) ──
  // Esto evita que "verificando..." quede pegado si hay un error más adelante.
  {
    const statusEl = document.getElementById('backend-status-text');
    const badgeEl  = document.getElementById('db-status-badge');
    if (statusEl) {
      if (!isSupabaseConfigured) {
        statusEl.textContent = 'Sin configurar — usando localStorage';
        statusEl.className   = 'font-semibold text-amber-600';
        if (badgeEl) {
          badgeEl.textContent = '⚠ Sin DB';
          badgeEl.className   = 'ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-100 text-amber-700';
          badgeEl.classList.remove('hidden');
        }
      } else if (sessionStorage.getItem(DB_STATUS_KEY) === 'connected') {
        statusEl.textContent = 'Conectado · PostgreSQL';
        statusEl.className   = 'font-semibold text-emerald-600';
        if (badgeEl) {
          badgeEl.textContent = '✓ DB activa';
          badgeEl.className   = 'ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700';
          badgeEl.classList.remove('hidden');
        }
      } else {
        statusEl.textContent = 'conectando...';
        statusEl.className   = 'font-semibold text-gray-500';
      }
    }
  }

  if (sessionStorage.getItem(SESSION_KEY) === '1') showDashboard();

  loginForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const pw = (document.getElementById('admin-password') as HTMLInputElement).value;
    if (pw === ADMIN_PASSWORD) {
      sessionStorage.setItem(SESSION_KEY, '1');
      loginError.classList.add('hidden');
      showDashboard();
    } else {
      loginError.classList.remove('hidden');
      (document.getElementById('admin-password') as HTMLInputElement).value = '';
    }
  });

  logoutBtn.addEventListener('click', () => {
    sessionStorage.removeItem(SESSION_KEY);
    loginOverlay.classList.remove('hidden');
    dashboard.classList.add('hidden');
    (document.getElementById('admin-password') as HTMLInputElement).value = '';
  });

  // ── Metrics ───────────────────────────────────────────────
  function loadMetrics() {
    const log      = getVisitLog();
    const todayKey = new Date().toISOString().slice(0, 10);

    // Unique IPs (from visit log)
    const uniqueTotal = new Set(log.map(v => v.ip).filter(Boolean)).size;
    const uniqueToday = new Set(
      log.filter(v => v.timestamp?.slice(0, 10) === todayKey && v.ip).map(v => v.ip)
    ).size;

    // Raw page views (from simple counters — includes visits not captured by IP API)
    const rawTotal = Number(localStorage.getItem(VISITS_KEY) ?? 0);
    const rawToday = getTodayVisits();

    const subs = getSubmissions();
    // Conversion based on unique visitors
    const conv = uniqueTotal > 0 ? ((subs.length / uniqueTotal) * 100).toFixed(1) : '0.0';

    setText('visits-today',    String(uniqueToday));
    setText('visits-total',    String(uniqueTotal));
    setText('pageviews-today', String(rawToday));
    setText('pageviews-total', String(rawTotal));
    setText('forms-count',     String(subs.length));
    setText('conversion-rate', conv + '%');
    setText('forms-badge',     subs.length > 0 ? `+${subs.length}` : 'Leads');
    setText('table-summary',   `${subs.length} registro${subs.length !== 1 ? 's' : ''}`);
  }

  function setText(id: string, val: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = val;
  }

  function getTodayVisits(): number {
    try {
      const d = JSON.parse(localStorage.getItem(VISITS_DAY_KEY) ?? '{}');
      return d.date === new Date().toISOString().slice(0, 10) ? (d.count ?? 0) : 0;
    } catch { return 0; }
  }

  // ── Submissions ───────────────────────────────────────────
  interface Submission { nombre:string; telefono:string; email:string; tipo_negocio:string; mensaje:string; fecha:string; estado:string; }

  function getSubmissions(): Submission[] {
    try { return JSON.parse(localStorage.getItem(SUBS_KEY) ?? '[]'); } catch { return []; }
  }

  function renderTable(query: string) {
    const tbody   = document.getElementById('submissions-tbody')!;
    const empty   = document.getElementById('empty-state')!;
    const all     = getSubmissions();
    const q       = query.toLowerCase().trim();
    const list    = q ? all.filter(s =>
      s.nombre.toLowerCase().includes(q) || s.email.toLowerCase().includes(q) ||
      s.telefono.includes(q) || (s.tipo_negocio ?? '').toLowerCase().includes(q)
    ) : all;

    if (!list.length) {
      tbody.innerHTML = '';
      empty.classList.remove('hidden');
    } else {
      empty.classList.add('hidden');
      tbody.innerHTML = list.slice().reverse().map((s, i) => {
        const realIdx = all.findIndex(sub => sub.fecha === s.fecha && sub.email === s.email);
        const estado = s.estado || 'Nuevo';
        const statusStyle = statusCSS(estado);
        return `
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="px-6 py-4 text-gray-400 text-xs font-mono">${list.length - i}</td>
          <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">${esc(s.nombre)}</td>
          <td class="px-6 py-4 text-gray-600 whitespace-nowrap">${esc(s.telefono)}</td>
          <td class="px-6 py-4 text-gray-600">${esc(s.email)}</td>
          <td class="px-6 py-4"><span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 capitalize">${esc(s.tipo_negocio||'—')}</span></td>
          <td class="px-6 py-4 text-gray-500 text-xs max-w-[180px] truncate">${esc(s.mensaje||'—')}</td>
          <td class="px-6 py-4 text-gray-400 text-xs whitespace-nowrap">${fmtDate(s.fecha)}</td>
          <td class="px-6 py-4">
            <select class="status-select text-xs font-semibold px-2.5 py-1.5 rounded-full border-0 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#E85C1A]"
              data-real-idx="${realIdx}" style="${statusStyle}">
              <option value="Nuevo"          ${estado==='Nuevo'?'selected':''}>🟢 Nuevo</option>
              <option value="Contactado"     ${estado==='Contactado'?'selected':''}>🔵 Contactado</option>
              <option value="En seguimiento" ${estado==='En seguimiento'?'selected':''}>🟠 En seguimiento</option>
              <option value="Cerrado"        ${estado==='Cerrado'?'selected':''}>⚫ Cerrado</option>
            </select>
          </td>
        </tr>`;
      }).join('');
    }
    setText('table-summary', `${list.length} registro${list.length !== 1 ? 's' : ''}${q ? ' (filtrado)' : ''}`);
  }

  function esc(s: string) {
    return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function fmtDate(iso: string) {
    try {
      const d = new Date(iso);
      return d.toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'})+' '+d.toLocaleTimeString('es-PE',{hour:'2-digit',minute:'2-digit'});
    } catch { return iso; }
  }
  function statusCSS(estado: string): string {
    const map: Record<string,string> = {
      'Nuevo':          'background:#dcfce7;color:#15803d;',
      'Contactado':     'background:#dbeafe;color:#1d4ed8;',
      'En seguimiento': 'background:#ffedd5;color:#c2410c;',
      'Cerrado':        'background:#f3f4f6;color:#374151;',
    };
    return map[estado] ?? map['Nuevo'];
  }

  searchInput.addEventListener('input', () => renderTable(searchInput.value));

  // Status change via event delegation
  document.getElementById('submissions-tbody')!.addEventListener('change', (e) => {
    const sel = e.target as HTMLSelectElement;
    if (!sel.classList.contains('status-select')) return;
    const idx = Number(sel.dataset.realIdx);
    const subs = getSubmissions();
    if (subs[idx]) {
      subs[idx].estado = sel.value;
      localStorage.setItem(SUBS_KEY, JSON.stringify(subs));
      sel.setAttribute('style', statusCSS(sel.value));
    }
  });

  exportBtn.addEventListener('click', () => {
    const subs = getSubmissions();
    if (!subs.length) { alert('No hay datos para exportar.'); return; }
    const headers = ['#','Nombre','WhatsApp','Email','Tipo negocio','Mensaje','Fecha','Estado'];
    const rows = subs.slice().reverse().map((s, i) => [i+1, s.nombre, s.telefono, s.email, s.tipo_negocio, s.mensaje, s.fecha, s.estado]);
    const csv = [headers,...rows].map(r => r.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(',')).join('\r\n');
    const url = URL.createObjectURL(new Blob(['﻿'+csv],{type:'text/csv;charset=utf-8;'}));
    Object.assign(document.createElement('a'),{href:url,download:`usqay-leads-${new Date().toISOString().slice(0,10)}.csv`}).click();
    URL.revokeObjectURL(url);
  });

  clearBtn.addEventListener('click', () => {
    if (!confirm('¿Limpiar todos los formularios almacenados localmente?')) return;
    localStorage.removeItem(SUBS_KEY);
    loadMetrics();
    renderTable('');
  });

  // ── Plan Editor ───────────────────────────────────────────
  function getDefaultPlans(): PlanData[] {
    const el = document.getElementById('default-plans');
    try { return JSON.parse(el?.textContent ?? '[]'); } catch { return []; }
  }

  function getCurrentPlans(): PlanData[] {
    try {
      const stored = localStorage.getItem(PLANS_OVERRIDE);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
      return getDefaultPlans();
    } catch { return getDefaultPlans(); }
  }

  function renderPlanEditor() {
    editingPlans = getCurrentPlans();
    if (editingPlans.length === 0) editingPlans = getDefaultPlans();
    rebuildGrid();
  }

  function rebuildGrid() {
    const grid = document.getElementById('plans-editor-grid')!;
    grid.innerHTML = editingPlans.map((plan, i) => buildPlanCard(plan, i)).join('');
    attachCardListeners();
    updatePlanCheckboxes();        // safe — uses getElementById internally
    updateMonthlyPlanCheckboxes(); // safe — uses getElementById internally
  }

  function buildPlanCard(plan: PlanData, i: number): string {
    const featuredClass = plan.featured ? 'is-featured' : '';
    const savings = plan.priceMonthly !== plan.priceAnnual
      ? `Ahorra S/ ${Math.round((plan.priceMonthly - plan.priceAnnual) * 12)} al año (${Math.round((1 - plan.priceAnnual / plan.priceMonthly) * 100)}% dto.)`
      : 'Sin descuento anual';

    return `
    <div class="plan-editor-card ${featuredClass} border rounded-2xl p-4 space-y-3" data-plan-index="${i}">

      <!-- Header: emoji + name + featured + delete -->
      <div class="flex items-center gap-2">
        <input type="text" data-field="emoji" value="${esc(plan.emoji)}" placeholder="🍽️"
          class="!w-10 !px-1 text-center text-xl" title="Emoji del plan" />
        <input type="text" data-field="name" value="${esc(plan.name)}" placeholder="Nombre del plan"
          class="flex-1 font-bold" />
        <button class="remove-plan-btn flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-lg bg-red-100 text-red-600 hover:bg-red-600 hover:text-white transition-all text-xl font-bold leading-none shadow-sm" data-plan-index="${i}" title="Eliminar plan">×</button>
      </div>

      <!-- Featured toggle -->
      <label class="flex items-center gap-2 cursor-pointer select-none">
        <input type="checkbox" data-field="featured" ${plan.featured ? 'checked' : ''}
          class="!w-4 !h-4 rounded" style="accent-color:#E85C1A;" />
        <span class="text-xs font-semibold text-gray-600">Marcar como plan popular (destacado)</span>
      </label>
      ${plan.featured ? `
      <input type="text" data-field="featuredLabel" value="${esc(plan.featuredLabel||'⭐ Más popular')}" placeholder="Etiqueta destacado" class="text-xs" />` : ''}

      <!-- Prices -->
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-xs text-gray-500 mb-1 font-semibold">Precio mensual (S/)</label>
          <input type="number" data-field="priceMonthly" value="${plan.priceMonthly}" min="0" class="font-bold text-[#1B3D6E]" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1 font-semibold">Precio anual /mes (S/)</label>
          <input type="number" data-field="priceAnnual" value="${plan.priceAnnual}" min="0" class="font-bold text-[#E85C1A]" />
        </div>
      </div>
      <p class="text-xs text-gray-400 -mt-1">${savings}</p>

      <!-- CTA -->
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-xs text-gray-500 mb-1 font-semibold">Texto del botón</label>
          <input type="text" data-field="ctaLabel" value="${esc(plan.ctaLabel)}" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1 font-semibold">Estilo botón</label>
          <select data-field="ctaVariant" class="border border-gray-200 rounded-lg px-2 py-1.5 text-xs w-full">
            <option value="primary" ${plan.ctaVariant==='primary'?'selected':''}>Primary (naranja)</option>
            <option value="secondary" ${plan.ctaVariant==='secondary'?'selected':''}>Secondary (gris)</option>
          </select>
        </div>
      </div>

      <!-- Description -->
      <div>
        <label class="block text-xs text-gray-500 mb-1 font-semibold">Descripción</label>
        <textarea data-field="description" rows="2" class="text-xs resize-none">${esc(plan.description)}</textarea>
      </div>

      <!-- Features -->
      <div>
        <label class="block text-xs text-gray-500 mb-1.5 font-semibold">Características</label>
        <div class="features-list space-y-1.5" data-plan-index="${i}">
          ${plan.features.map((f, fi) => `
            <div class="feature-row" data-feature-index="${fi}">
              <input type="checkbox" data-field="included" ${f.included ? 'checked' : ''} title="${f.included ? 'Incluido' : 'No incluido'}" />
              <input type="text" data-field="label" value="${esc(f.label)}" placeholder="Característica..." />
              <button class="remove-feature-btn flex-shrink-0 w-5 h-5 flex items-center justify-center text-red-300 hover:text-red-500 text-base leading-none transition-colors" data-plan-index="${i}" data-feature-index="${fi}">×</button>
            </div>`).join('')}
        </div>
        <button class="add-feature-btn mt-2 w-full text-xs text-[#E85C1A] border border-dashed border-[#E85C1A]/50 rounded-lg py-1.5 hover:bg-orange-50 transition-all font-semibold" data-plan-index="${i}">
          + Agregar característica
        </button>
      </div>
    </div>`;
  }

  function readCardData(card: Element): PlanData {
    const i = Number(card.getAttribute('data-plan-index'));
    const get = (field: string) => (card.querySelector(`[data-field="${field}"]`) as HTMLInputElement|null)?.value ?? '';
    const getChecked = (field: string) => (card.querySelector(`[data-field="${field}"]`) as HTMLInputElement|null)?.checked ?? false;

    const featureRows = card.querySelectorAll('.feature-row');
    const features: Feature[] = Array.from(featureRows).map(row => ({
      label:    (row.querySelector('[data-field="label"]') as HTMLInputElement).value,
      included: (row.querySelector('[data-field="included"]') as HTMLInputElement).checked,
    }));

    const isFeatured = getChecked('featured');

    return {
      ...editingPlans[i],
      emoji:            get('emoji'),
      name:             get('name'),
      featured:         isFeatured,
      featuredLabel:    isFeatured ? (get('featuredLabel') || '⭐ Más popular') : '',
      description:      get('description'),
      priceMonthly:     Number(get('priceMonthly')) || 0,
      priceAnnual:      Number(get('priceAnnual'))  || 0,
      ctaLabel:         get('ctaLabel'),
      ctaVariant:       get('ctaVariant'),
      annualSavingsLabel: '',
      features,
    };
  }

  function collectAllPlans(): PlanData[] {
    const cards = document.querySelectorAll('.plan-editor-card');
    return Array.from(cards).map(readCardData);
  }

  function attachCardListeners() {
    // Remove plan
    document.querySelectorAll('.remove-plan-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const i = Number((btn as HTMLElement).dataset.planIndex);
        if (editingPlans.length <= 1) { alert('Debe haber al menos un plan.'); return; }
        if (!confirm(`¿Eliminar el plan "${editingPlans[i].name}"?`)) return;
        editingPlans = collectAllPlans();
        editingPlans.splice(i, 1);
        rebuildGrid();
      });
    });

    // Add feature
    document.querySelectorAll('.add-feature-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const i = Number((btn as HTMLElement).dataset.planIndex);
        editingPlans = collectAllPlans();
        editingPlans[i].features.push({ label: 'Nueva característica', included: true });
        rebuildGrid();
      });
    });

    // Remove feature
    document.querySelectorAll('.remove-feature-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pi = Number((btn as HTMLElement).dataset.planIndex);
        const fi = Number((btn as HTMLElement).dataset.featureIndex);
        editingPlans = collectAllPlans();
        editingPlans[pi].features.splice(fi, 1);
        rebuildGrid();
      });
    });

    // Featured checkbox — re-render card to show/hide label input
    document.querySelectorAll('[data-field="featured"]').forEach(cb => {
      cb.addEventListener('change', () => {
        editingPlans = collectAllPlans();
        rebuildGrid();
      });
    });

    // Live savings label update on price change
    document.querySelectorAll('[data-field="priceMonthly"],[data-field="priceAnnual"]').forEach(input => {
      input.addEventListener('input', () => {
        const card = (input as HTMLElement).closest('.plan-editor-card')!;
        const mo = Number((card.querySelector('[data-field="priceMonthly"]') as HTMLInputElement).value) || 0;
        const an = Number((card.querySelector('[data-field="priceAnnual"]')  as HTMLInputElement).value) || 0;
        const p  = card.querySelector('p.text-xs.text-gray-400');
        if (!p) return;
        if (mo === an || an === 0) { p.textContent = 'Sin descuento anual'; }
        else {
          const saved = Math.round((mo - an) * 12);
          const pct   = Math.round((1 - an / mo) * 100);
          p.textContent = `Ahorra S/ ${saved} al año (${pct}% dto.)`;
        }
      });
    });
  }

  // ── Auto-guardado silencioso ─────────────────────────────
  // Cada vez que el usuario edita un campo del plan editor, guardamos en
  // localStorage para que un F5 nunca pierda los cambios.
  let autoSaveTimer: ReturnType<typeof setTimeout> | null = null;
  function autoSavePlans() {
    if (autoSaveTimer) clearTimeout(autoSaveTimer);
    autoSaveTimer = setTimeout(() => {
      const current = collectAllPlans();
      if (current.length > 0) {
        current.forEach(p => {
          if (p.priceMonthly !== p.priceAnnual && p.priceAnnual > 0) {
            const saved = Math.round((p.priceMonthly - p.priceAnnual) * 12);
            const pct   = Math.round((1 - p.priceAnnual / p.priceMonthly) * 100);
            p.annualSavingsLabel = `Facturado anualmente — ahorras S/ ${saved} (${pct}% dto.)`;
          } else { p.annualSavingsLabel = ''; }
        });
        localStorage.setItem(PLANS_OVERRIDE, JSON.stringify(current));
      }
    }, 600); // debounce 600 ms
  }

  document.getElementById('plans-editor-grid')!.addEventListener('input', autoSavePlans);
  document.getElementById('plans-editor-grid')!.addEventListener('change', autoSavePlans);

  // Save plans
  document.getElementById('save-plans-btn')!.addEventListener('click', () => {
    editingPlans = collectAllPlans();
    if (editingPlans.length === 0) {
      alert('No hay planes para guardar. Usa "Restaurar defaults" primero.');
      return;
    }
    // Auto-generate annualSavingsLabel
    editingPlans.forEach(p => {
      if (p.priceMonthly !== p.priceAnnual && p.priceAnnual > 0) {
        const saved = Math.round((p.priceMonthly - p.priceAnnual) * 12);
        const pct   = Math.round((1 - p.priceAnnual / p.priceMonthly) * 100);
        p.annualSavingsLabel = `Facturado anualmente — ahorras S/ ${saved} (${pct}% dto.)`;
      } else {
        p.annualSavingsLabel = '';
      }
    });
    localStorage.setItem(PLANS_OVERRIDE, JSON.stringify(editingPlans));
    showToast('Cambios guardados correctamente');
    rebuildGrid();
  });

  // Add new plan
  document.getElementById('add-plan-btn')!.addEventListener('click', () => {
    // If there are cards in DOM, sync from them; otherwise keep current editingPlans
    const cards = document.querySelectorAll('.plan-editor-card');
    if (cards.length > 0) editingPlans = collectAllPlans();
    editingPlans.push({
      id: `plan-${Date.now()}`,
      name: 'Nuevo Plan',
      emoji: '✨',
      featured: false,
      featuredLabel: '',
      description: 'Descripción del nuevo plan.',
      priceMonthly: 0,
      priceAnnual: 0,
      annualSavingsLabel: '',
      ctaLabel: 'Solicitar demo',
      ctaVariant: 'secondary',
      ctaHref: '#contacto',
      features: [{ label: 'Característica 1', included: true }],
    });
    rebuildGrid();
    document.getElementById('plans-editor-grid')!.lastElementChild?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  // Reset to defaults
  document.getElementById('reset-plans-btn')!.addEventListener('click', () => {
    if (!confirm('¿Restaurar todos los planes a los valores originales? Se perderán los cambios no guardados.')) return;
    localStorage.removeItem(PLANS_OVERRIDE);
    editingPlans = getDefaultPlans();
    rebuildGrid();
    showToast('Planes restaurados a los valores originales');
  });

  // ── Plan selector dropdown (for discount) ────────────────
  const planSelectorBtn      = document.getElementById('plan-selector-btn')!;
  const planSelectorDropdown = document.getElementById('plan-selector-dropdown')!;
  const selectAllCheckbox    = document.getElementById('select-all-plans') as HTMLInputElement;
  const planCheckboxList     = document.getElementById('plan-checkboxes-list')!;
  const planSelectorLabel    = document.getElementById('plan-selector-label')!;

  planSelectorBtn.addEventListener('click', (e) => {
    e.stopPropagation();
