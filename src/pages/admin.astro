  // ── Backend Section (Supabase) ────────────────────────────
  function applyConnectedUI() {
    const statusText     = document.getElementById('backend-status-text')!;
    const connectedBadge = document.getElementById('backend-connected-badge')!;
    const connectedDiv   = document.getElementById('backend-connected')!;
    const dbStatusBadge  = document.getElementById('db-status-badge')!;
    const dataSourceLabel = document.getElementById('data-source-label');
    statusText.textContent  = 'Conectado · PostgreSQL';
    statusText.className    = 'font-semibold text-emerald-600';
    connectedBadge.classList.remove('hidden');
    connectedDiv.classList.remove('hidden');
    dbStatusBadge.textContent = '✓ DB activa';
    dbStatusBadge.className   = 'ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700';
    dbStatusBadge.classList.remove('hidden');
    if (dataSourceLabel) dataSourceLabel.textContent = 'Supabase PostgreSQL';
  }

  async function initBackendSection() {
    const statusText      = document.getElementById('backend-status-text')!;
    const connectedBadge  = document.getElementById('backend-connected-badge')!;
    const disconnBadge    = document.getElementById('backend-disconnected-badge')!;
    const connectedDiv    = document.getElementById('backend-connected')!;
    const setupDiv        = document.getElementById('backend-setup')!;
    const dbStatusBadge   = document.getElementById('db-status-badge')!;
    const dataSourceLabel = document.getElementById('data-source-label')!;

    if (!isSupabaseConfigured) {
      statusText.textContent    = 'Sin configurar — usando localStorage';
      statusText.className      = 'font-semibold text-amber-600';
      disconnBadge.classList.remove('hidden');
      setupDiv.classList.remove('hidden');
      dbStatusBadge.textContent = '⚠ Sin DB';
      dbStatusBadge.className   = 'ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-100 text-amber-700';
      dbStatusBadge.classList.remove('hidden');
      sessionStorage.removeItem(DB_STATUS_KEY);
      return;
    }

    // Si ya conectó antes en esta sesión → mostrar estado conectado de inmediato
    if (sessionStorage.getItem(DB_STATUS_KEY) === 'connected') {
      applyConnectedUI();
    } else {
      statusText.textContent = 'conectando...';
    }
    try {
      const [allVisits, todayVisits, allLeads] = await Promise.all([
        fetchVisits(1000),
        fetchVisitsToday(),
        fetchSubmissions(),
      ]);

      // Update metrics from DB
      const uniqueIPsToday = new Set(todayVisits.map(v => v.ip).filter(Boolean)).size;
      const uniqueIPsTotal = new Set(allVisits.map(v => v.ip).filter(Boolean)).size;
      setText('visits-total',     String(uniqueIPsTotal));
      setText('visits-today',     String(uniqueIPsToday));
      // Páginas vistas = total registros en DB (centralizado, todos los dispositivos)
      setText('pageviews-total',  String(allVisits.length));
      setText('pageviews-today',  String(todayVisits.length));
      setText('forms-count',     String(allLeads.length));
      const convRate = uniqueIPsTotal > 0
        ? ((allLeads.length / uniqueIPsTotal) * 100).toFixed(1)
        : '0.0';
      setText('conversion-rate', convRate + '%');
      setText('forms-badge',     allLeads.length > 0 ? `+${allLeads.length}` : 'Leads');

      // DB stats
      setText('db-visits-total', String(allVisits.length));
      setText('db-visits-today', String(todayVisits.length));
      setText('db-leads-total',  String(allLeads.length));
      setText('db-unique-ips',   String(uniqueIPsTotal));

      // Update submission table with DB data (map created_at → fecha)
      const mapped = allLeads.map(s => ({
        nombre:       s.nombre,
        telefono:     s.telefono,
        email:        s.email,
        tipo_negocio: s.tipo_negocio,
        mensaje:      s.mensaje,
        fecha:        s.created_at ?? '',
        estado:       s.estado ?? 'Nuevo',
        _db_id:       s.id ?? '',
      }));
      renderTableFromDB(mapped);

      // Update visit log with DB data
      const visitsMapped = allVisits.map(v => ({
        ip: v.ip, country: v.country, city: v.city, region: v.region,
        isp: v.isp, device: v.device, browser: v.browser,
        timestamp: v.created_at ?? '', page: v.page,
      }));
      localStorage.setItem('usqay_visit_log', JSON.stringify(visitsMapped));

      // UI + guardar estado en sessionStorage para no mostrar "verificando..." al recargar
      applyConnectedUI();
      sessionStorage.setItem(DB_STATUS_KEY, 'connected');

    } catch (err: any) {
      const detail = err?.message ?? String(err);
      statusText.textContent = `Error: ${detail.slice(0, 80)}`;
      statusText.className   = 'font-semibold text-red-500';
      disconnBadge.classList.remove('hidden');
      setupDiv.classList.remove('hidden');
      sessionStorage.removeItem(DB_STATUS_KEY);
      console.error('Supabase error:', err);

      // Show visible alert so the user knows what failed
      const alertDiv = document.createElement('div');
      alertDiv.className = 'mx-6 mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700';
      alertDiv.innerHTML = `<strong>⚠ Error al conectar con Supabase:</strong><br/><code class="block mt-1 break-all">${detail}</code><br/>
        <span class="mt-2 block text-gray-600">Posibles causas:<br/>
        1. El proyecto de Supabase está en pausa (entra a supabase.com → Resume project)<br/>
        2. Las credenciales en <code>.env</code> son incorrectas<br/>
        3. El servidor de desarrollo no fue reiniciado después de crear el <code>.env</code></span>`;
      setupDiv.prepend(alertDiv);
    }
  }

  // Render table from DB submissions (have _db_id instead of array index)
  function renderTableFromDB(list: any[]) {
    const tbody = document.getElementById('submissions-tbody')!;
    const empty = document.getElementById('empty-state')!;
    if (!list.length) { tbody.innerHTML = ''; empty.classList.remove('hidden'); return; }
    empty.classList.add('hidden');
    tbody.innerHTML = list.map((s, i) => {
      const estado = s.estado || 'Nuevo';
      return `
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="px-6 py-4 text-gray-400 text-xs font-mono">${i + 1}</td>
          <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">${esc(s.nombre)}</td>
          <td class="px-6 py-4 text-gray-600 whitespace-nowrap">${esc(s.telefono)}</td>
          <td class="px-6 py-4 text-gray-600">${esc(s.email)}</td>
          <td class="px-6 py-4"><span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 capitalize">${esc(s.tipo_negocio||'—')}</span></td>
          <td class="px-6 py-4 text-gray-500 text-xs max-w-[180px] truncate">${esc(s.mensaje||'—')}</td>
          <td class="px-6 py-4 text-gray-400 text-xs whitespace-nowrap">${fmtDate(s.fecha)}</td>
          <td class="px-6 py-4">
            <select class="status-select-db text-xs font-semibold px-2.5 py-1.5 rounded-full border-0 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#E85C1A]"
              data-db-id="${esc(s._db_id)}" style="${statusCSS(estado)}">
              <option value="Nuevo"          ${estado==='Nuevo'?'selected':''}>🟢 Nuevo</option>
              <option value="Contactado"     ${estado==='Contactado'?'selected':''}>🔵 Contactado</option>
              <option value="En seguimiento" ${estado==='En seguimiento'?'selected':''}>🟠 En seguimiento</option>
              <option value="Cerrado"        ${estado==='Cerrado'?'selected':''}>⚫ Cerrado</option>
            </select>
          </td>
        </tr>`;
    }).join('');
    setText('table-summary', `${list.length} registro${list.length !== 1 ? 's' : ''} · DB`);

    // Status change via DB
    tbody.querySelectorAll('.status-select-db').forEach(sel => {
      sel.addEventListener('change', async () => {
        const s = sel as HTMLSelectElement;
        const id = s.dataset.dbId ?? '';
        s.setAttribute('style', statusCSS(s.value));
        await updateSubmissionStatus(id, s.value);
      });
    });
  }

